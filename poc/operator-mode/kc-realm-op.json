        "name": "os-user",
        "description": "OpenShell os-user"
      },
      {
        "name": "os-admin",
        "description": "OpenShell os-admin"
      },
      {
        "name": "tenant-a-users",
        "description": "租户侧组，只用于平台 Controller 同步 workspace 成员"
      },
      {
        "name": "tenant-b-users",
        "description": "租户侧组，只用于平台 Controller 同步 workspace 成员"
      },
      {
        "name": "T-50933-USER",
        "description": "租户侧组，只用于平台 Controller 同步 workspace 成员"
      },
      {
        "name": "T-50933-ADMIN",
        "description": "租户侧组，只用于平台 Controller 同步 workspace 成员"
      }
    ]
  },
  "users": [
