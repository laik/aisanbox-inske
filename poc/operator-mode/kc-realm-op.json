        "tenant-b-users"
      ],
      "requiredActions": []
    },
    {
      "username": "tadmin",
      "enabled": true,
      "firstName": "TAdmin",
      "lastName": "Platform",
      "email": "tadmin@aisanbox.example",
      "credentials": [
        {
          "type": "password",
          "value": "poc3pass",
          "temporary": false
        }
      ],
      "realmRoles": [
        "os-user",
        "os-admin",
